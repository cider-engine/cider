<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>netstandard2.0</TargetFramework>
	  <PackageId>Cider.Sdk</PackageId>
	  <PackageVersion>0.0.4-alpha</PackageVersion>
	  <Authors>cider-engine</Authors>
	  <PackageType>MSBuildSdk</PackageType>
	  <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	  <IncludeBuildOutput>false</IncludeBuildOutput>
	  <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cider.Task\Cider.Task.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="_ResolveTaskAssembly" BeforeTargets="_GetPackageFiles;GenerateNuspec">
		<MSBuild Projects="..\Cider.Task\Cider.Task.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
			<Output TaskParameter="TargetOutputs" ItemName="_TaskAssembly" />
		</MSBuild>

		<ItemGroup>
			<None Include="@(_TaskAssembly)" Pack="true" PackagePath="tasks" Visible="false" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk" />
		<None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk" />
		<None Include="shaders\**\*" Pack="true" PackagePath="shaders" />
		<None Include="tools\**\*" Pack="true" PackagePath="tools" />
	</ItemGroup>

</Project>
