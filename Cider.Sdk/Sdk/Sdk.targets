<Project>
	<PropertyGroup>
		<_IsOnBrowser>false</_IsOnBrowser>
		<_IsOnBrowser Condition="(!$(TargetFrameworks.Contains('-browser')) And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == '' And $(BuildToBrowser) == 'true') Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browser'">true</_IsOnBrowser>
		<_CiderTest>false</_CiderTest>
		<_CiderTest Condition="$(CiderTest) == 'true'">true</_CiderTest>
	</PropertyGroup>
	<Import Condition="!$(_IsOnBrowser)" Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
	<Import Condition="$(_IsOnBrowser)" Project="Sdk.props" Sdk="Microsoft.NET.Sdk.WebAssembly" />

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == '' And !$(_IsOnBrowser)">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>

	<ItemGroup Condition="$(_CiderTest)">
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Cider\Cider.csproj" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Cider.Generator\Cider.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="!$(_CiderTest)">
		<PackageReference Include="Cider" Version="$(CiderVersion)" />
		<PackageReference Include="Cider.Generator" Version="$(CiderVersion)" />
	</ItemGroup>

	<ItemGroup>
		<CiderAssets Include="$(CiderAssetsPath)\**\*" />
		<CiderShaders Include="$(CiderAssetsPath)\$(CiderShadersPath)\**\*" Exclude="**\*.meta" />

		<_CiderPublicShaders Include="@(CiderShaders)" />

		<_CiderInternalShaders Include="$(MSBuildThisFileDirectory)..\shaders\**\*" />

		<CiderShaders Include="@(_CiderInternalShaders)" />

		<_PackedCiderAssets Include="@(CiderAssets)" Exclude="@(CiderShaders);**\*.meta" />
		
		<CompilerVisibleProperty Include="MSBuildProjectDirectory" />

		<AdditionalFiles Include="**\*.cider" />
		<AdditionalFiles Include="$(CiderAssetsPath)\**\*.meta" />

		<Compile Remove="Platform\**\*.cs" />
	</ItemGroup>

	<!--Android Start-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<MonoAndroidResourcePrefix Condition="$(MonoAndroidResourcePrefix) == ''">Platform\Android\Resources</MonoAndroidResourcePrefix>
		<AndroidManifest Condition="$(AndroidManifest) == ''">Platform\Android\AndroidManifest.xml</AndroidManifest>
	</PropertyGroup>
	
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Compile Include="Platform\Android\**\*.cs" />

		<!--此属性只对Android可见-->
		<CompilerVisibleProperty Include="MonoAndroidAssetsPrefix" />

		<AndroidAsset Remove="@(AndroidAsset)" />
	</ItemGroup>
	<!--Android End-->
	
	<!--Browser Start-->
	<PropertyGroup Condition="$(_IsOnBrowser)">
		<DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<WasmEnableExceptionHandling>false</WasmEnableExceptionHandling>
		<ResolveStaticWebAssetsInputsDependsOn>$(ResolveStaticWebAssetsInputsDependsOn);AddExtraStaticWebAssets</ResolveStaticWebAssetsInputsDependsOn>
		<ExtraStaticAssetsRoot>$(MSBuildProjectDirectory)\$(CiderAssetsPath)\</ExtraStaticAssetsRoot>
	</PropertyGroup>
	
	<ItemGroup Condition="$(_IsOnBrowser)">
		<PackageReference Include="Cider.NativeAssets.WebAssembly" Version="$(CiderVersion)" />
		
		<Compile Include="Platform\Browser\**\*.cs" />
		
		<Content Include="Platform\Browser\wwwroot\**\*">
			<Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<ContentRoot>$(MSBuildProjectDirectory)\Platform\Browser\wwwroot</ContentRoot>
			<!--根目录的wwwroot隐藏，子目录的wwwroot由默认None项自动加载，前提是EnableDefaultNoneItems为默认值或true-->
			<Visible>false</Visible>
		</Content>
		
		<StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
		<!--<NativeFileReference Include="*.a" />-->
		<!--<WasmFilesToIncludeInFileSystem Include="" />-->

		<!--Used by SDL_CreateWindowWithProperties-->
		<EmccExportedRuntimeMethod Include="requestFullscreen" />
	</ItemGroup>

	<Target Name="AddExtraStaticWebAssets" Condition="$(_IsOnBrowser)" DependsOnTargets="AssetProcess">
		<DefineStaticWebAssets
			CandidateAssets="@(_PackedCiderAssets)"
			SourceId="$(PackageId)"
			SourceType="Discovered"
			AssetKind="All"
			AssetMode="All"
			AssetRole="Primary"
			ContentRoot="$(ExtraStaticAssetsRoot)"
			BasePath="$(StaticWebAssetBasePath)">
			<Output TaskParameter="Assets" ItemName="_ExtraStaticWebAsset" />
		</DefineStaticWebAssets>

		<DefineStaticWebAssetEndpoints
			  CandidateAssets="@(_ExtraStaticWebAsset)"
			  ContentTypeMappings="@(StaticWebAssetContentTypeMapping)"
			  ExistingEndpoints="">
			<Output TaskParameter="Endpoints" ItemName="_ExtraStaticWebAssetEndpoint" />
		</DefineStaticWebAssetEndpoints>

		<ItemGroup>
			<StaticWebAsset Include="@(_ExtraStaticWebAsset)" />
			<StaticWebAssetEndpoint Include="@(_ExtraStaticWebAssetEndpoint)" />
		</ItemGroup>
	</Target>
	<!--Browser End-->
	
	<UsingTask Condition="$(_CiderTest)" TaskName="AssetTask" AssemblyFile="$(MSBuildThisFileDirectory)..\..\Cider.Task\bin\$(Configuration)\netstandard2.0\Cider.Task.dll" />
	<UsingTask Condition="!$(_CiderTest)" TaskName="AssetTask" AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\Cider.Task.dll" />

	<Target Name="CheckConfiguration" BeforeTargets="BeforeBuild">
		<Warning Condition="$(TargetFrameworks.Contains('-browser')) And $(BuildToBrowser) != ''"
			Text="The property BuildToBrowser will be ignored when browser is in TargetFrameworks." />
	</Target>

	<Target Name="AssetProcess" BeforeTargets="BeforeBuild" DependsOnTargets="AssetMetaPreprocess;ShaderCompile_Direct3D12;ShaderCompile_Vulkan;ShaderCompile_Metal">
		<ItemGroup>
			<_PackedCiderAssets Include="@(_CiderPublicCompiledShaders)">
				<Link>$(CiderAssetsPath)\$(CiderShadersPath)\%(_CiderPublicCompiledShaders.OriginalRecursiveDir)%(Filename)%(Extension)</Link>
				<TargetPath>$(CiderAssetsPath)\$(CiderShadersPath)\%(_CiderPublicCompiledShaders.OriginalRecursiveDir)%(Filename)%(Extension)</TargetPath>
			</_PackedCiderAssets>
			
			<_PackedCiderAssets Include="@(_CiderInternalCompiledShaders)">
				<Link>internal\%(_CiderInternalCompiledShaders.OriginalRecursiveDir)%(Filename)%(Extension)</Link>
				<TargetPath>internals\%(_CiderInternalCompiledShaders.OriginalRecursiveDir)%(Filename)%(Extension)</TargetPath>
			</_PackedCiderAssets>
			
			<!--Android Assets由AndroidAsset处理 不将其作为Content来避免XA0101警告-->
			<Content Include="@(_PackedCiderAssets)" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
				<!--Browser Assets由StaticWebAssetsSdk处理-->
				<CopyToOutputDirectory Condition="!$(_IsOnBrowser)">PreserveNewest</CopyToOutputDirectory>
			</Content>
			
			<AndroidAsset Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="@(_PackedCiderAssets)" />
		</ItemGroup>
	</Target>

	<Target Name="AssetMetaPreprocess">
		<!--更好的方法是在添加资源时自己就添加.meta-->
		<!--如果是当前构建生成的.meta代码里肯定是引用不到的（不知道ID），所以AdditionalFiles不管了-->
		<AssetTask Assets="@(CiderAssets)" />
	</Target>

	<PropertyGroup Condition="$([System.OperatingSystem]::IsWindows())">
		<_ShaderCompilingPlatform>win-x64</_ShaderCompilingPlatform>
		<_ShaderCompilerExe>shadercross.exe</_ShaderCompilerExe>
		<_UseUtf8Encoding>Always</_UseUtf8Encoding>
	</PropertyGroup>

	<PropertyGroup Condition="$([System.OperatingSystem]::IsLinux())">
		<_ShaderCompilingPlatform>linux-x64</_ShaderCompilingPlatform>
		<_ShaderCompilerExe>shadercross</_ShaderCompilerExe>
		<_UseUtf8Encoding>Detect</_UseUtf8Encoding>
	</PropertyGroup>

	<PropertyGroup Condition="$([System.OperatingSystem]::IsMacOS())">
		<_ShaderCompilingPlatform>osx-arm64</_ShaderCompilingPlatform>
		<_ShaderCompilerExe>shadercross</_ShaderCompilerExe>
		<_UseUtf8Encoding>Detect</_UseUtf8Encoding>
	</PropertyGroup>

	<PropertyGroup>
		<_ShaderRunningPlatform>$(RuntimeIdentifier)</_ShaderRunningPlatform>
		<_ShaderRunningPlatform Condition="$(_ShaderRunningPlatform) == ''">$(_ShaderCompilingPlatform)</_ShaderRunningPlatform>
	</PropertyGroup>

	<Target Name="ShaderCompile_Direct3D12" Condition="$(_ShaderRunningPlatform.StartsWith('win'))"
			Inputs="@(CiderShaders)" Outputs="@(CiderShaders->'$(IntermediateOutputPath)shaders\compiled\dxil\%(RecursiveDir)%(Filename)%(Extension).dxil')">
		<Error Condition="$(_ShaderCompilingPlatform) == ''" Text="Current building platform is unsupported" />

		<MakeDir Directories="$(IntermediateOutputPath)shaders\compiled\dxil\%(CiderShaders.RecursiveDir)" Condition="!Exists('$(IntermediateOutputPath)shaders\compiled\dxil\%(CiderShaders.RecursiveDir)')" />
	
		<Exec UseUtf8Encoding="$(_UseUtf8Encoding)" Command="&quot;$(MSBuildThisFileDirectory)..\tools\SDL_shadercross\$(_ShaderCompilingPlatform)\bin\$(_ShaderCompilerExe)&quot; &quot;%(CiderShaders.FullPath)&quot; -o &quot;$(IntermediateOutputPath)shaders\compiled\dxil\%(CiderShaders.RecursiveDir)%(CiderShaders.Filename)%(CiderShaders.Extension).dxil&quot;" />

		<ItemGroup>
			<_CiderInternalCompiledShaders Include="@(_CiderInternalShaders->'$(IntermediateOutputPath)shaders\compiled\dxil\%(RecursiveDir)%(Filename)%(Extension).dxil')" Type="dxil" OriginalRecursiveDir="%(RecursiveDir)" />
			<_CiderPublicCompiledShaders Include="@(_CiderPublicShaders->'$(IntermediateOutputPath)shaders\compiled\dxil\%(RecursiveDir)%(Filename)%(Extension).dxil')" Type="dxil" OriginalRecursiveDir="%(RecursiveDir)" />
			
			<_CompiledShadersWithoutSource Include="$(IntermediateOutputPath)shaders\compiled\dxil\**\*.dxil" />
			<_CompiledShadersWithoutSource Remove="@(_CiderInternalCompiledShaders);@(_CiderPublicCompiledShaders)" />
		</ItemGroup>

		<Delete Files="@(_CompiledShadersWithoutSource)" />

		<ItemGroup>
			<_CompiledShadersWithoutSource Remove="@(_CompiledShadersWithoutSource)" />
		</ItemGroup>
	</Target>
	
	<Target Name="ShaderCompile_Vulkan" Condition="!$(_ShaderRunningPlatform.StartsWith('osx'))"
			Inputs="@(CiderShaders)" Outputs="@(CiderShaders->'$(IntermediateOutputPath)shaders\compiled\spv\%(RecursiveDir)%(Filename)%(Extension).spv')">
		<Error Condition="$(_ShaderCompilingPlatform) == ''" Text="Current building platform is unsupported" />

		<MakeDir Directories="$(IntermediateOutputPath)shaders\compiled\spv\%(CiderShaders.RecursiveDir)" Condition="!Exists('$(IntermediateOutputPath)shaders\compiled\spv\%(CiderShaders.RecursiveDir)')" />

		<Exec UseUtf8Encoding="$(_UseUtf8Encoding)" Command="&quot;$(MSBuildThisFileDirectory)..\tools\SDL_shadercross\$(_ShaderCompilingPlatform)\bin\$(_ShaderCompilerExe)&quot; &quot;%(CiderShaders.FullPath)&quot; -o &quot;$(IntermediateOutputPath)shaders\compiled\spv\%(CiderShaders.RecursiveDir)%(CiderShaders.Filename)%(CiderShaders.Extension).spv&quot;" />

		<ItemGroup>
			<_CiderInternalCompiledShaders Include="@(_CiderInternalShaders->'$(IntermediateOutputPath)shaders\compiled\spv\%(RecursiveDir)%(Filename)%(Extension).spv')" Type="spv" OriginalRecursiveDir="%(RecursiveDir)" />
			<_CiderPublicCompiledShaders Include="@(_CiderPublicShaders->'$(IntermediateOutputPath)shaders\compiled\spv\%(RecursiveDir)%(Filename)%(Extension).spv')" Type="spv" OriginalRecursiveDir="%(RecursiveDir)" />

			<_CompiledShadersWithoutSource Include="$(IntermediateOutputPath)shaders\compiled\spv\**\*.spv" />
			<_CompiledShadersWithoutSource Remove="@(_CiderInternalCompiledShaders);@(_CiderPublicCompiledShaders)" />
		</ItemGroup>

		<Delete Files="@(_CompiledShadersWithoutSource)" />

		<ItemGroup>
			<_CompiledShadersWithoutSource Remove="@(_CompiledShadersWithoutSource)" />
		</ItemGroup>
	</Target>
	
	<Target Name="ShaderCompile_Metal" Condition="$(_ShaderRunningPlatform.StartsWith('osx'))"
			Inputs="@(CiderShaders)" Outputs="@(CiderShaders->'$(IntermediateOutputPath)shaders\compiled\msl\%(RecursiveDir)%(Filename)%(Extension).msl')">
		<Error Condition="$(_ShaderCompilingPlatform) == ''" Text="Current building platform is unsupported" />

		<MakeDir Directories="$(IntermediateOutputPath)shaders\compiled\msl\%(CiderShaders.RecursiveDir)" Condition="!Exists('$(IntermediateOutputPath)shaders\compiled\msl\%(CiderShaders.RecursiveDir)')" />

		<Exec UseUtf8Encoding="$(_UseUtf8Encoding)" Command="&quot;$(MSBuildThisFileDirectory)..\tools\SDL_shadercross\$(_ShaderCompilingPlatform)\bin\$(_ShaderCompilerExe)&quot; &quot;%(CiderShaders.FullPath)&quot; -o &quot;$(IntermediateOutputPath)shaders\compiled\msl\%(CiderShaders.RecursiveDir)%(CiderShaders.Filename)%(CiderShaders.Extension).msl&quot;" />

		<ItemGroup>
			<_CiderInternalCompiledShaders Include="@(_CiderInternalShaders->'$(IntermediateOutputPath)shaders\compiled\msl\%(RecursiveDir)%(Filename)%(Extension).msl')" Type="msl" OriginalRecursiveDir="%(RecursiveDir)" />
			<_CiderPublicCompiledShaders Include="@(_CiderPublicShaders->'$(IntermediateOutputPath)shaders\compiled\msl\%(RecursiveDir)%(Filename)%(Extension).msl')" Type="msl" OriginalRecursiveDir="%(RecursiveDir)" />

			<_CompiledShadersWithoutSource Include="$(IntermediateOutputPath)shaders\compiled\msl\**\*.msl" />
			<_CompiledShadersWithoutSource Remove="@(_CiderInternalCompiledShaders);@(_CiderPublicCompiledShaders)" />
		</ItemGroup>

		<Delete Files="@(_CompiledShadersWithoutSource)" />

		<ItemGroup>
			<_CompiledShadersWithoutSource Remove="@(_CompiledShadersWithoutSource)" />
		</ItemGroup>
	</Target>

	<Import Condition="!$(_IsOnBrowser)" Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
	<Import Condition="$(_IsOnBrowser)" Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.WebAssembly" />
</Project>